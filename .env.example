# =========================================================================
# NEV Climate Data — Variables d'environnement (exemple)
# Copier ce fichier en ".env" à la racine du projet et adapter les valeurs.
# Le fichier ".env" réel ne doit JAMAIS être versionné (voir .gitignore).
# =========================================================================

# --- Application Symfony -------------------------------------------------
# dev | prod | test
APP_ENV=dev
# Générer une valeur aléatoire forte, ex: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change_me_generate_a_random_secret

# --- Base de données PostgreSQL / TimescaleDB -----------------------------
# Le service "database" utilise l'image timescale/timescaledb:latest-pg16
# (compatible protocole PostgreSQL) depuis le Point 3 du plan (A1.3).
POSTGRES_DB=nev_climate_data
POSTGRES_USER=nev_admin
POSTGRES_PASSWORD=change_me_use_a_strong_password
# Port exposé sur la machine hôte (utile pour un client SQL local)
POSTGRES_PORT=5432

# --- Backend Symfony (conteneur) -----------------------------------------
# Port exposé sur la machine hôte pour accéder à l'API
BACKEND_PORT=8080

# --- Authentification JWT (Point 4 du plan — A1.4) ------------------------
# Passphrase de la paire de clés JWT générée via :
#   docker compose exec backend php bin/console lexik:jwt:generate-keypair --overwrite
# Générer une valeur aléatoire forte, ex: openssl rand -hex 16
JWT_PASSPHRASE=change_me_use_a_strong_passphrase

# --- CORS (A2.1) -----------------------------------------------------------
# Regex des origines autorisées à appeler /api/* depuis un navigateur (voir
# backend/config/packages/nelmio_cors.yaml, origin_regex: true). Ne jamais
# utiliser "*" : un motif explicite (dev ici - couvre le tunnel SSH local et
# les URLs forwardées de Codespaces ; remplacer par l'origine réelle en prod).
CORS_ALLOWED_ORIGIN_REGEX=^https?://localhost:8123$|^https://[a-z0-9-]+-8123\.app\.github\.dev$

# --- Cache Redis (A2.5) ------------------------------------------------------
# DSN du pool de cache dédié aux agrégats analytiques (voir
# backend/config/packages/cache.yaml, pool "cache.analytics", TTL 900s /
# 15 min). Le pool "app" par défaut (rate limiter de login, A1.4) n'est pas
# concerné et reste sur son backend fichier habituel.
REDIS_DSN=redis://redis:6379

# --- MinIO (Volet B — Bronze/Silver/Gold data lake, B1.1) ------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_use_a_strong_password

# --- IATI Datastore (Volet B — B1.2, connecteur GCF) -----------------------
# Clé gratuite : inscription sur https://developer.iatistandard.org/, puis
# Subscriptions -> "Exploratory" (aucune approbation requise). Utilisée pour
# interroger https://api.iatistandard.org/datastore/activity/select.
IATI_API_KEY=change_me_get_a_free_key_from_developer.iatistandard.org

# --- Gemini API (Volet B — B1.5, extracteur PDF assisté par IA) ------------
# Clé gratuite (palier "Free tier", sans carte bancaire) : aistudio.google.com
# -> "Get API key" -> "Create API key". Déviation assumée par rapport au
# roadmap (qui nomme "API Claude") : l'API Claude est payante dès le premier
# appel (pas de palier gratuit), Gemini a un vrai palier gratuit avec support
# PDF natif (jusqu'à 50 Mo / 1000 pages, modèles Flash/Flash-Lite) - voir la
# spec B1.5. Note : sur le palier gratuit, les données envoyées peuvent être
# utilisées par Google pour améliorer ses produits - acceptable ici (rapports
# publics de bailleurs/gouvernements, aucune donnée personnelle).
GEMINI_API_KEY=change_me_get_a_free_key_from_aistudio.google.com
