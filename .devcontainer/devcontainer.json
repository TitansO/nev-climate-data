{
  "name": "NEV Climate Data",

  // Deliberately NOT "dockerComposeFile" + "service": that combination
  // makes the Codespaces platform bring up the *entire* compose stack
  // (db, redis, backend, backend-worker) as a blocking step of container
  // creation itself, via its own extra compose-override layers. In
  // practice this failed reliably: TimescaleDB's healthcheck (5s
  // interval/timeout, 10 retries = 50s budget) loses the race against the
  // backend image's own build (the "intl" PHP extension alone compiles
  // for ~90s), so "docker compose ... up -d" aborts with "dependency
  // failed to start: container nev-climate-data-db is unhealthy" and the
  // whole codespace falls back to a bare recovery container (no docker
  // CLI, /home/codespace not writable) - see git history around
  // 2026-08-28 for the two failed creation logs.
  //
  // A plain base image + the docker-outside-of-docker feature avoids all
  // of that: container creation is just "pull a generic image", nothing
  // dependency-ordered or health-checked, and it still leaves a real
  // `docker`/`docker compose` CLI available afterwards (talking to the
  // same host daemon) for the usual manual
  // `docker compose up -d` once the codespace is actually up - exactly
  // the workflow that has always worked reliably in this project.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    // Node was never needed on the Codespace itself before A3.1/A3.2's
    // React migration - frontend/package.json's Tailwind CLI build always
    // ran on a contributor's own machine, never here. The React/Vite
    // toolchain (npm install, vite build) needs a real Node runtime
    // in-container instead. Node 20 LTS: comfortably covers Vite 5's
    // minimum (18+).
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "workspaceFolder": "/workspaces/nev-climate-data",

  // Ports stay declared here specifically so their visibility is *fixed
  // in code*, not in Codespaces' session state. Without this file, GitHub
  // Codespaces defaults every newly-forwarded port to "private" and
  // treats a port as "new" again after its listening process is fully
  // torn down and recreated (e.g. a full "docker compose down" + "up") -
  // that's why `gh codespace ports visibility 8080:public` kept reverting
  // and had to be re-run by hand. Declared here, it survives that.
  //
  // 8080 (backend/API) and 8123 (frontend static server) are meant to be
  // reachable directly from any browser (see frontend/README.md - "Base de
  // l'URL de l'API"), so both are public. 5432 (Postgres) and 6379 (Redis)
  // are internal-only and deliberately left off this list (Codespaces'
  // private default is what we want there).
  "portsAttributes": {
    "8080": {
      "label": "Backend API",
      "visibility": "public"
    },
    "8123": {
      "label": "Frontend",
      "visibility": "public"
    }
  }
}
